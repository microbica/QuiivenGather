# ============================================================
# gatherQuiiven — variables de entorno (Fase 0, localhost)
# Copiar a .env para desarrollo local. NUNCA commitear .env real.
# Este archivo .env.example SÍ se versiona y documenta qué se requiere.
# ============================================================

# ---- General ----
NODE_ENV=development
APP_NAME=gatherQuiiven

# ---- apps/web (Vite: solo VITE_* llega al navegador) ----
# URL del Colyseus en local. En Lightsail será wss://<dominio>/colyseus
VITE_COLYSEUS_URL=ws://localhost:2567
VITE_MAP_DEFAULT=/maps/demo.tmj
VITE_PROXIMITY_RADIUS_TILES=5
# Auth (Fase 0: placeholder; Fase 2: Clerk/Supabase — rellenar entonces)
VITE_AUTH_PROVIDER=none
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# STUN para descubrir IP pública en la malla P2P (Fase 3). Solo refleja IP,
# no cursa media. En prod: coturn propio (Fase 5).
VITE_STUN_URL=stun:stun.l.google.com:19302

# ---- apps/server (Colyseus) ----
SERVER_PORT=2567
SERVER_CORS_ORIGIN=http://localhost:5173
# patchRate ms (50 = 20Hz). Subir en prod si hay CPU pressure.
GAME_PATCH_RATE=50
GAME_MAX_CLIENTS=50
# JWT para futuro LiveKit + TURN (Fase 3). Generar con: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SECRET=

# ---- Redis (futuro, Fase 2.5+ escala; no requerido en Fase 0) ----
REDIS_URL=
