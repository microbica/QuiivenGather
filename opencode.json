{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pnpm build*": "allow",
      "pnpm test*": "allow",
      "pnpm lint*": "allow"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "temperature": 0.1,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "build": {
      "mode": "primary",
      "temperature": 0.3
    }
  }
}
